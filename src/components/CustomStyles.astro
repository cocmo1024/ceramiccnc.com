---
import '@fontsource-variable/inter';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(30 96 117);
    --aw-color-secondary: rgb(21 73 89);
    --aw-color-accent: rgb(68 117 134);
    --aw-color-link: rgb(30 96 117);
    --aw-color-focus: rgb(30 96 117);

    --aw-color-text-heading: rgb(20 23 29);
    --aw-color-text-default: rgb(48 55 68);
    --aw-color-text-page: var(--aw-color-text-default);
    --aw-color-text-muted: rgb(102 112 133);
    --aw-color-bg-page: rgb(245 246 248);
    --aw-color-bg-page-dark: rgb(7 10 16);
    --aw-color-surface: rgb(255 255 255);
    --aw-color-surface-raised: rgb(240 242 245);
    --aw-color-border: rgb(213 217 225);
    --aw-color-border-control: rgb(100 116 139);

    ::selection {
      background-color: rgb(218 238 242);
      color: rgb(18 67 80);
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(75 159 181);
    --aw-color-secondary: rgb(51 130 152);
    --aw-color-accent: rgb(182 211 219);
    --aw-color-link: rgb(104 196 218);
    --aw-color-focus: rgb(176 228 239);

    --aw-color-text-heading: rgb(246 247 244);
    --aw-color-text-default: rgb(213 218 226);
    --aw-color-text-page: var(--aw-color-text-default);
    --aw-color-text-muted: rgb(148 156 170);
    --aw-color-bg-page: rgb(7 10 16);
    --aw-color-bg-page-dark: rgb(7 10 16);
    --aw-color-surface: rgb(15 19 27);
    --aw-color-surface-raised: rgb(21 26 36);
    --aw-color-border: rgb(47 55 68);
    --aw-color-border-control: rgb(86 101 125);

    ::selection {
      background-color: rgb(27 93 109);
      color: rgb(234 250 253);
    }
  }
</style>
