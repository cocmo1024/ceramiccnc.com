---
import { Icon } from 'astro-icon/components';

import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import RfqForm from '~/components/forms/RfqForm.astro';
import Button from '~/components/ui/Button.astro';
import heroImage from '~/assets/images/ceramic/hero-ceramic-cnc.webp';
import partsImage from '~/assets/images/ceramic/application-1.webp';
import rodImage from '~/assets/images/ceramic/application-2.webp';
import fluidControlImage from '~/assets/images/ceramic/application-3.webp';
import semiconductorImage from '~/assets/images/ceramic/application-4.webp';
import processImage from '~/assets/images/ceramic/application-5.webp';
import aluminaImage from '~/assets/images/ceramic/application-6.webp';
import zirconiaImage from '~/assets/images/ceramic/application-7.webp';
import siliconNitrideImage from '~/assets/images/ceramic/application-8.webp';
import formingImage from '~/assets/images/ceramic/application-9.webp';
import grindingImage from '~/assets/images/ceramic/application-10.webp';
import lappingImage from '~/assets/images/ceramic/application-11.webp';
import inspectionImage from '~/assets/images/ceramic/application-12.webp';
import packagingImage from '~/assets/images/ceramic/application-13.webp';
import routeStudyImage from '~/assets/images/ceramic/application-14.webp';
import featureStudyImage from '~/assets/images/ceramic/application-15.webp';
import { ceramicProductCategoryCount } from '~/data/ceramic-catalog';
import { createCeramicServiceSchema, createItemListSchema } from '~/utils/structured-data';

const whatsappHref =
  'https://wa.me/8615301541312?text=Hello%2C%20I%20would%20like%20to%20discuss%20a%20precision%20ceramic%20project.';

const metadata = {
  title: 'Precision Ceramic Manufacturing | Custom Ceramic Parts',
  ignoreTitleTemplate: true,
  description:
    'Custom precision ceramic manufacturing, CNC machining, diamond grinding, lapping, inspection planning, and secure CAD quotation for advanced ceramic parts.',
  openGraph: {
    images: [
      {
        url: '~/assets/images/ceramic/hero-ceramic-cnc.webp',
        width: 1200,
        height: 628,
        alt: 'Precision machined advanced ceramic components',
      },
    ],
    type: 'website',
  },
  structuredData: [
    createCeramicServiceSchema(),
    createItemListSchema('Precision ceramic manufacturing service scope', [
      {
        name: 'Ceramic material and process-route review',
        description:
          'Material-grade review, forming-route selection, machining access, finishing, and acceptance planning.',
        url: '/#process-route-support',
      },
      {
        name: 'Custom ceramic product families',
        description: 'Twenty-three product categories organized for engineering and procurement review.',
        url: '/products/',
      },
      {
        name: 'Ceramic CNC machining and finishing',
        description: 'Diamond grinding, honing, lapping, polishing, microfeatures, and inspection-aware finishing.',
        url: '/capabilities/',
      },
      {
        name: 'Precision ceramic quotation',
        description:
          'Secure submission of CAD, material, quantity, critical features, finishing, and inspection scope.',
        url: '/rfq/',
      },
    ]),
  ],
};

const serviceScope = [
  {
    title: 'Material and route review',
    description:
      'Review the ceramic family, grade, blank route, geometry, datums, critical features, and acceptance risk.',
    icon: 'tabler:ruler-measure',
  },
  {
    title: 'Forming and sintering',
    description:
      'Match pressing, injection molding, or sourced blanks to geometry, quantity, and material requirements.',
    icon: 'tabler:hexagon',
  },
  {
    title: 'Precision machining',
    description: 'Plan CNC machining, diamond grinding, honing, lapping, polishing, slots, holes, and edge conditions.',
    icon: 'tabler:tool',
  },
  {
    title: 'Inspection and delivery',
    description: 'Agree dimensional, surface, profile, interface, cleaning, packaging, and document requirements.',
    icon: 'tabler:microscope',
  },
];

const applicationCapabilities = [
  {
    title: 'Precision shapes',
    description: 'Rods, tubes, rings, shafts, sleeves, plates, pins, gauges, plungers, and structural parts.',
    icon: 'tabler:components',
  },
  {
    title: 'Fluid control and dosing',
    description: 'Pump, plunger, filling, dispensing-valve, seal, nozzle, and corrosive-fluid components.',
    icon: 'tabler:droplet',
  },
  {
    title: 'Semiconductor and vacuum',
    description: 'Vacuum pickup, wafer-handling, laser, chamber, electrical-insulation, and fixture components.',
    icon: 'tabler:cpu',
  },
  {
    title: 'Automation and wear',
    description: 'Locating, guiding, sliding, wear-resistant, insulating, and precision automation components.',
    icon: 'tabler:settings',
  },
  {
    title: 'Medical and food equipment',
    description: 'Drawing-controlled ceramic parts reviewed for functional surfaces, cleaning, and packaging needs.',
    icon: 'tabler:stethoscope',
  },
  {
    title: 'Electrical and high-temperature',
    description: 'Insulators, substrates, thermal parts, laser hardware, and structures for demanding environments.',
    icon: 'tabler:flame',
  },
];

const materialRoutes = [
  {
    name: 'Alumina and ZTA',
    description: 'Broad structural, wear, electrical-insulation, fixture, and fluid-control applications by grade.',
    image: aluminaImage,
    alt: 'Precision alumina and zirconia-toughened alumina ceramic parts',
  },
  {
    name: 'Zirconia systems',
    description: 'Yttria-, ceria-, or magnesia-stabilized routes reviewed against strength, wear, and environment.',
    image: zirconiaImage,
    alt: 'Precision zirconia ceramic components',
  },
  {
    name: 'Si3N4 and specialty ceramics',
    description: 'Silicon nitride, SiC, AlN, BN, MACOR, and fused silica for requirement-specific applications.',
    image: siliconNitrideImage,
    alt: 'Silicon nitride and specialty technical ceramic parts',
  },
];

const thermalDesignSteps = [
  {
    number: '01',
    title: 'Define the function',
    description:
      'Map loads, wear, fluid, vacuum, electrical, thermal, temperature, cleanliness, and interface requirements.',
  },
  {
    number: '02',
    title: 'Compare material routes',
    description:
      'Assess ceramic family, grade, blank availability, forming route, machining state, and production volume.',
  },
  {
    number: '03',
    title: 'Review manufacturability',
    description:
      'Balance walls, bores, slots, edges, tolerance stack-up, grinding access, lapping stock, and handling risk.',
  },
  {
    number: '04',
    title: 'Lock acceptance',
    description:
      'Define the drawing revision, datums, CTQs, surface criteria, inspection evidence, cleaning, and packaging scope.',
  },
];

const thermalDesignInputs = [
  'Part function, operating environment, and failure mode',
  'Material family, grade, or property priorities',
  'Drawing, CAD, datums, GD&T, and critical surfaces',
  'Starting blank, quantity, timing, and repeat-volume outlook',
  'Inspection evidence, cleaning, packaging, and documentation',
];

const thermalDesignEvidence = [
  {
    image: routeStudyImage,
    imageClass: 'object-cover',
    alt: 'Ceramic product and process route review',
    label: 'Route review | blank to finished part',
    title: 'Screen the material and blank route',
    description:
      'A material name alone does not define the route. Grade, blank condition, shrinkage state, stock, geometry, and volume must be checked together.',
  },
  {
    image: featureStudyImage,
    imageClass: 'object-cover',
    alt: 'Precision ceramic feature and datum review',
    label: 'Feature review | datums and CTQs',
    title: 'Protect the function-critical geometry',
    description:
      'Separate functional surfaces from general geometry so grinding access, edge protection, tolerance stack-up, and inspection effort go where they matter.',
  },
  {
    image: inspectionImage,
    imageClass: 'object-cover',
    alt: 'Inspection planning for precision ceramic components',
    label: 'Acceptance review | measurement evidence',
    title: 'Plan evidence before production',
    description:
      'Match CMM, optical, profile, flatness, Ra, visual, and document requirements to the drawing before quotation and production release.',
  },
];

const productionEnvelopes = [
  {
    label: 'Forming',
    value: 'Pressing / injection / sourced blank',
    image: formingImage,
    alt: 'Ceramic forming and blank route planning',
  },
  {
    label: 'Machining',
    value: 'CNC / diamond grinding / cutting',
    image: grindingImage,
    alt: 'Precision ceramic CNC machining and diamond grinding',
  },
  {
    label: 'Surface finishing',
    value: 'Honing / lapping / polishing',
    image: lappingImage,
    alt: 'Ceramic honing, lapping, and polishing',
  },
  {
    label: 'Inspection',
    value: 'Dimensional / optical / profile / Ra',
    image: inspectionImage,
    alt: 'Precision ceramic component inspection',
  },
  {
    label: 'Delivery control',
    value: 'Cleaning / protection / packaging',
    image: packagingImage,
    alt: 'Clean and protective packaging for ceramic parts',
  },
];

const processSteps = [
  {
    number: '01',
    title: 'Define the requirement',
    description:
      'Send CAD or drawing, part function, material or property priorities, quantity, interfaces, and acceptance needs.',
  },
  {
    number: '02',
    title: 'Lock the route',
    description:
      'Review material grade, blank or forming route, machining sequence, CTQs, finishing, inspection, and handling risk.',
  },
  {
    number: '03',
    title: 'Form, machine, and finish',
    description:
      'The part moves through the agreed ceramic route, precision machining, grinding, lapping, polishing, or honing.',
  },
  {
    number: '04',
    title: 'Inspect and deliver',
    description:
      'Inspection evidence is produced against the agreed scope before cleaning, protective packaging, and delivery.',
  },
];

const applicationExamples = [
  {
    image: rodImage,
    alt: 'Precision ceramic rods, tubes, rings, shafts, sleeves, and pins',
    title: 'Rods, tubes, rings, and sleeves',
    description: 'Drawing-controlled cylindrical parts with bores, shoulders, fits, and functional surfaces.',
    className: 'lg:col-span-7',
  },
  {
    image: fluidControlImage,
    alt: 'Ceramic pump, plunger, dosing, valve, seal, and nozzle components',
    title: 'Fluid-control components',
    description: 'Plungers, pump parts, dosing parts, valve components, seals, and nozzles.',
    className: 'lg:col-span-5',
  },
  {
    image: semiconductorImage,
    alt: 'Ceramic vacuum, semiconductor, laser, and automation components',
    title: 'Vacuum and semiconductor hardware',
    description: 'Vacuum pickup, wafer handling, laser, chamber, fixture, and insulation components.',
    className: 'lg:col-span-5',
  },
  {
    image: partsImage,
    alt: 'Custom precision ceramic structural parts',
    title: 'Custom structural ceramic parts',
    description: 'Plates, sheets, gauges, pins, injection-molded parts, and drawing-specific shapes.',
    className: 'lg:col-span-7',
  },
];
---

<Layout metadata={metadata}>
  <section class="relative overflow-hidden border-b border-page-border bg-surface">
    <div
      class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_72%_38%,rgba(47,143,168,0.18),transparent_34%),linear-gradient(to_bottom,transparent,rgba(0,0,0,0.08))]"
      aria-hidden="true"
    >
    </div>

    <div
      class="relative mx-auto grid min-h-[650px] max-w-5xl items-center gap-12 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-[0.96fr_1.04fr] lg:gap-14"
    >
      <div class="max-w-[37rem]">
        <p class="flex items-center gap-3 text-xs font-semibold text-accent sm:text-sm">
          <span class="h-2 w-2 rounded-full bg-accent shadow-[0_0_18px_rgba(194,104,58,0.9)]"></span>
          Precision ceramic manufacturing | Engineering review
        </p>
        <h1 class="mt-5 font-heading text-4xl font-bold leading-[1.08] tracking-[-0.025em] text-heading sm:text-5xl">
          Precision ceramic parts built around function and acceptance
        </h1>
        <p class="mt-7 max-w-xl text-base leading-7 text-muted sm:text-lg">
          We support custom advanced ceramic parts from material and process-route review through precision machining,
          finishing, inspection, and protective delivery. Send the available drawing package for a scoped engineering
          review.
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
          <Button
            variant="primary"
            text="Send drawing or CAD"
            href="#rfq-form"
            icon="tabler:file-upload"
            class="w-full justify-center px-5 py-3 sm:w-auto"
            data-aw-cta-location="homepage_hero"
          />
          <Button
            variant="secondary"
            text="Discuss on WhatsApp"
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            icon="tabler:brand-whatsapp"
            class="w-full justify-center px-5 py-3 sm:w-auto"
            data-aw-instant-contact-link
            data-aw-contact-channel="whatsapp"
            data-aw-cta-location="homepage_hero"
          />
        </div>
        <p class="mt-3 text-sm leading-6 text-muted">
          Prefer email?
          <button
            class="font-semibold text-link hover:underline"
            type="button"
            data-aw-copy-email="info@szcomo.com"
            data-aw-cta-location="homepage_hero"
          >
            Copy info@szcomo.com
          </button>
        </p>

        <div class="mt-8 flex flex-wrap gap-x-6 gap-y-3 text-sm leading-6 text-muted">
          <span class="inline-flex items-center gap-2">
            <Icon name="tabler:check" class="h-4 w-4 text-accent" />
            23 ceramic product categories
          </span>
          <span class="inline-flex items-center gap-2">
            <Icon name="tabler:check" class="h-4 w-4 text-accent" />
            Prototype and production
          </span>
          <span class="inline-flex items-center gap-2">
            <Icon name="tabler:check" class="h-4 w-4 text-accent" />
            Finished-part delivery
          </span>
        </div>
      </div>

      <div class="relative">
        <div
          class="relative overflow-hidden rounded-xl border border-page-border bg-page/70 p-4 shadow-[0_28px_80px_rgba(0,0,0,0.28)] sm:p-7"
        >
          <div
            class="pointer-events-none absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.025)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.025)_1px,transparent_1px)] bg-[size:32px_32px]"
            aria-hidden="true"
          >
          </div>
          <Image
            src={heroImage}
            alt="Precision machined advanced ceramic components"
            class="relative h-auto w-full object-contain"
            style="object-fit: contain;"
            widths={[480, 640, 960, 1280]}
            sizes="(max-width: 1023px) calc(100vw - 3rem), 480px"
            width={2048}
            height={1152}
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>

        <div
          class="relative -mt-6 ml-4 grid max-w-[92%] grid-cols-3 divide-x divide-page-border rounded-md border border-page-border bg-surface/95 shadow-panel backdrop-blur sm:ml-8"
        >
          <div class="px-3 py-4 sm:px-4">
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-muted">Process</p>
            <p class="mt-1 text-sm font-semibold leading-5 text-heading">Form · machine · finish</p>
          </div>
          <div class="px-3 py-4 sm:px-4">
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-muted">Materials</p>
            <p class="mt-1 text-sm font-semibold leading-5 text-heading">Al2O3 · ZrO2 · Si3N4</p>
          </div>
          <div class="px-3 py-4 sm:px-4">
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-muted">Output</p>
            <p class="mt-1 text-sm font-semibold leading-5 text-heading">Inspected parts</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-page-border bg-page">
    <div
      class="mx-auto grid max-w-5xl divide-y divide-page-border px-4 sm:grid-cols-3 sm:divide-x sm:divide-y-0 sm:px-6"
    >
      <div class="py-6 sm:pr-8">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent">Service</p>
        <p class="mt-2 font-semibold text-heading">Custom ceramic production</p>
      </div>
      <div class="py-6 sm:px-8">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent">Scope</p>
        <p class="mt-2 font-semibold text-heading">Form · machine · inspect</p>
      </div>
      <div class="py-6 sm:pl-8">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent">Start</p>
        <p class="mt-2 font-semibold text-heading">Drawing and requirement review</p>
      </div>
    </div>
  </section>

  <section class="bg-page py-16 sm:py-24" aria-labelledby="who-we-are">
    <div class="mx-auto grid max-w-5xl gap-12 px-4 sm:px-6 lg:grid-cols-[0.82fr_1.18fr] lg:gap-16">
      <div>
        <p class="text-sm font-semibold text-accent">01 | Who we are</p>
        <h2
          id="who-we-are"
          class="mt-3 scroll-mt-24 font-heading text-3xl font-bold leading-tight tracking-[-0.02em] text-heading sm:text-4xl"
        >
          A ceramic manufacturing service built around finished parts
        </h2>
        <p class="mt-6 text-base leading-7 text-muted">
          CERAMIC CNC is the precision ceramic manufacturing service of Suzhou Como Precision Materials Co., Ltd. We
          review the drawing, define the route, manufacture the part, complete finishing, and supply the agreed
          evidence.
        </p>
        <p class="mt-4 text-base leading-7 text-muted">
          The engineering discussion stays focused on the part: function, geometry, material state, downstream
          operations, acceptance evidence, quantity, and timing.
        </p>
        <a class="mt-7 inline-flex items-center gap-2 font-semibold text-link hover:underline" href="#rfq-form">
          Send your drawing
          <Icon name="tabler:arrow-down" class="h-4 w-4" />
        </a>
      </div>

      <div class="grid border-t border-page-border sm:grid-cols-2">
        {
          serviceScope.map((item) => (
            <article class="border-b border-page-border py-7 sm:odd:pr-7 sm:even:border-l sm:even:pl-7">
              <div class="flex h-10 w-10 items-center justify-center rounded-md border border-page-border bg-surface">
                <Icon name={item.icon} class="h-5 w-5 text-accent" />
              </div>
              <h3 class="mt-5 font-heading text-lg font-semibold text-heading">{item.title}</h3>
              <p class="mt-2 text-sm leading-6 text-muted">{item.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-y border-page-border bg-surface py-16 sm:py-24" aria-labelledby="what-we-make">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="grid gap-7 lg:grid-cols-[0.82fr_1.18fr] lg:items-end lg:gap-16">
        <div>
          <p class="text-sm font-semibold text-accent">02 | What we make</p>
          <h2
            id="what-we-make"
            class="mt-3 scroll-mt-24 font-heading text-3xl font-bold leading-tight tracking-[-0.02em] text-heading sm:text-4xl"
          >
            {ceramicProductCategoryCount} product categories for precision, fluid, vacuum, and automation systems
          </h2>
        </div>
        <p class="text-base leading-7 text-muted">
          The catalogue covers drawing-specific shapes, cylindrical parts, pump and valve components, semiconductor and
          vacuum hardware, wear parts, and material-led ceramic components.
        </p>
      </div>

      <div
        class="mt-12 grid gap-px overflow-hidden rounded-md border border-page-border bg-page-border sm:grid-cols-2 lg:grid-cols-3"
      >
        {
          applicationCapabilities.map((item) => (
            <article class="bg-page p-6 sm:p-8">
              <span class="flex h-11 w-11 items-center justify-center rounded-md border border-page-border bg-surface">
                <Icon name={item.icon} class="h-5 w-5 text-accent" />
              </span>
              <h3 class="mt-7 font-heading text-xl font-semibold text-heading">{item.title}</h3>
              <p class="mt-3 max-w-md text-sm leading-6 text-muted">{item.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-b border-page-border bg-page py-16 sm:py-24" aria-labelledby="process-route-support">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <div class="grid gap-7 lg:grid-cols-[0.82fr_1.18fr] lg:items-end lg:gap-16">
        <div>
          <p class="text-sm font-semibold text-accent">03 | Process-route support</p>
          <h2
            id="process-route-support"
            class="mt-3 scroll-mt-24 font-heading text-3xl font-bold leading-tight tracking-[-0.02em] text-heading sm:text-4xl"
          >
            From functional requirements to a manufacturable ceramic route
          </h2>
        </div>
        <div class="space-y-4 text-base leading-7 text-muted">
          <p>
            A project can start with finished CAD or with a drawing and functional requirements. We connect material
            family, grade, blank or forming route, machining sequence, finishing, and acceptance evidence.
          </p>
          <p>
            Tight tolerances are project-specific. Applying them everywhere can increase cost and fracture risk without
            improving function, so CTQs and datum relationships are reviewed first.
          </p>
        </div>
      </div>

      <ol class="mt-12 grid border-y border-page-border sm:grid-cols-2 lg:grid-cols-4">
        {
          thermalDesignSteps.map((item) => (
            <li class="border-b border-page-border py-7 sm:px-6 sm:odd:pl-0 sm:even:border-l lg:border-b-0 lg:border-l lg:px-6 lg:[&:nth-child(3)]:!pl-6 lg:first:border-l-0 lg:first:pl-0 lg:last:pr-0">
              <span class="font-mono text-sm font-semibold text-accent">{item.number}</span>
              <h3 class="mt-4 font-heading text-lg font-semibold text-heading">{item.title}</h3>
              <p class="mt-2 text-sm leading-6 text-muted">{item.description}</p>
            </li>
          ))
        }
      </ol>

      <div class="mt-12 border-t border-page-border pt-8">
        <div class="max-w-3xl">
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent">
            Route, feature control, and evidence
          </p>
          <h3 class="mt-3 font-heading text-2xl font-bold text-heading">
            Three gates before the ceramic route is frozen
          </h3>
          <p class="mt-3 text-sm leading-6 text-muted">
            Ceramic performance depends on the material state, feature geometry, surface condition, and acceptance
            method. The route is valuable only when those variables are tied to the actual operating requirement.
          </p>
        </div>

        <div class="mt-8 grid gap-7 lg:grid-cols-3">
          {
            thermalDesignEvidence.map((item) => (
              <figure class="group border-t border-page-border pt-5">
                <div class="overflow-hidden rounded-lg border border-page-border bg-surface">
                  <Image
                    src={item.image}
                    alt={item.alt}
                    class={`aspect-[16/10] w-full ${item.imageClass}`}
                    widths={[480, 720, 960]}
                    sizes="(max-width: 1023px) calc(100vw - 2rem), 320px"
                    width={960}
                    height={600}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <figcaption class="mt-5">
                  <p class="text-xs font-semibold uppercase tracking-[0.12em] text-accent">{item.label}</p>
                  <h4 class="mt-2 font-heading text-xl font-semibold text-heading">{item.title}</h4>
                  <p class="mt-2 text-sm leading-6 text-muted">{item.description}</p>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>

      <div
        class="mt-10 grid gap-8 rounded-md border border-page-border bg-surface p-6 sm:p-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-12"
      >
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-accent">Two valid starting points</p>
          <h3 class="mt-3 font-heading text-2xl font-bold text-heading">
            Bring CAD or bring the functional requirements
          </h3>
          <p class="mt-3 text-sm leading-6 text-muted">
            Existing CAD moves into ceramic DFM and production review. An early requirement brief starts with material,
            blank, feature, and acceptance choices before the prototype route is agreed.
          </p>
          <Button
            variant="primary"
            text="Send requirements or CAD"
            href="#rfq-form"
